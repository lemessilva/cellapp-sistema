// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Porta 6543 + pgbouncer (Para aguentar o tranco do site)
  url       = "postgresql://postgres.utshqisoztujfbilrtms:samuelaratilemes@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
  // Porta 5432 (Apenas para migrações internas)
  directUrl = "postgresql://postgres.utshqisoztujfbilrtms:samuelaratilemes@aws-1-us-east-2.pooler.supabase.com:5432/postgres"
}	

enum Role {
  ADMIN
  SUPERVISOR
  LIDER
  MEMBRO
  MIDIA
}

enum MemberCategory {
  ADULTO
  CRIANCA
}

enum ReportStatus {
  RASCUNHO
  ENVIADO_LIDER
  APROVADO
  NAO_HOUVE
  EM_ANDAMENTO
  DEVOLVIDO // Novo status para fluxo de correção
}

enum ResourceType {
  PDF
  IMAGEM
  OUTRO
}

enum ResourceAudience {
  LIDERES
  GERAL
}

model User {
  id              String    @id @default(cuid())
  nome            String
  email           String?   @unique
  password        String? // Hash da senha
  resetToken      String?
  resetTokenExpiry DateTime?
  
  // Perfil
  telefone        String?
  data_nascimento DateTime?
  genero          String?   // 'M' | 'F'
  data_batismo    DateTime?
  endereco        String?
  numero          String?
  bairro          String?
  cidade          String?
  estado          String?
  cep             String?
  latitude        Float?
  longitude       Float?
  estado_civil    String?
  conjuge_nome    String?
  foto_url        String?
  whatsapp        String?
  sexo            String?
  dataNascimento  DateTime?
  naturalidade    String?
  ufNascimento    String?
  pontoReferencia String?
  nomePai         String?
  nomeMae         String?
  estadoCivil     String?
  nomeConjuge     String?
  escolaridade    String?
  profissao       String?
  dataConversao   DateTime?
  igrejaAnterior  String?
  
  dados_completos Boolean   @default(false)
  role            Role      @default(MEMBRO)
  categoria       MemberCategory @default(ADULTO)
  ativo           Boolean   @default(true)
  
  // Relacionamentos Hierárquicos
  celulaLiderada  Cell?     @relation("LiderCelula")
  celulaLiderada2 Cell?     @relation("Lider2Celula")
  celulasSupervisionadas Cell[] @relation("SupervisorCelula")
  celulasSupervisionadas2 Cell[] @relation("Supervisor2Celula")

  // Família / Responsável (Para Crianças)
  parentId      String?   // ID do Pai/Mãe
  parent        User?     @relation("ParentChild", fields: [parentId], references: [id])
  children      User[]    @relation("ParentChild")

  responsavelId   String?
  responsavel     User?     @relation("Responsavel", fields: [responsavelId], references: [id])
  dependentes     User[]    @relation("Responsavel")

  // Cargos em Célula
  celulaTesoureiro Cell[] @relation("TesoureiroCelula")
  celulaIntercessor Cell[] @relation("IntercessorCelula")
  celulaSecretario Cell[] @relation("SecretarioCelula")
  celulaEventos    Cell[] @relation("EventosCelula")
  celulaLouvor     Cell[] @relation("LouvorCelula")
  celulaAnfitriao  Cell[] @relation("AnfitriaoCelula")
  celulaMcp        Cell[] @relation("McpCelula")

  // Escalas
  rosterDirection  MeetingRoster[] @relation("RosterDirection")
  rosterWorship    MeetingRoster[] @relation("RosterWorship")
  rosterEvangelism MeetingRoster[] @relation("RosterEvangelism")
  rosterHost       MeetingRoster[] @relation("RosterHost")
  
  // Relatórios (Escala Realizada)
  reportDirection  MeetingReport[] @relation("ReportDirection")
  reportWorship    MeetingReport[] @relation("ReportWorship")
  reportEvangelism MeetingReport[] @relation("ReportEvangelism")
  reportHost       MeetingReport[] @relation("ReportHost")
  
  // Membresia
  celulaId        String?
  celula          Cell?     @relation("MembrosCelula", fields: [celulaId], references: [id])
  
  // Funcionalidades
  oikos           Oikos[]
  prayerRequests  PrayerRequest[]
  prayerLogs      PrayerLog[]
  invitesCriados  Invite[]  @relation("InviteCreator")
  attendance      MeetingAttendance[]
  kidsPillars     MeetingKidsPillars[]
  
  // Assinaturas de Fechamento Mensal
  assinaturasLider MonthlyClosure[] @relation("LiderAssinatura")
  assinaturasSupervisor MonthlyClosure[] @relation("SupervisorAssinatura")
  assinaturasCoord MonthlyClosure[] @relation("CoordAssinatura")

  // Feedbacks de Sistema
  systemFeedbacks SystemFeedback[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  joinedAt        DateTime  @default(now())

  // Growth Track
  growthProgress MemberGrowthProgress[]
  
  // Notifications
  notifications Notification[]

  // Eventos
  registrations Registration[]
  
  // Cartas de Correção criadas
  correctionsWritten ReportCorrection[]

  // Carteirinha
  memberSince     DateTime? @default(now()) // Data de entrada como membro
  bloodType       String?   // Ex: A+, O-
  emergencyContact String?  // Nome e Telefone
  status          String    @default("VISITANTE") // VISITANTE, ATIVO, INATIVO
}

model ChurchInfo {
  id          String   @id @default("main")
  name        String   @default("Minha Igreja")
  logoUrl     String?
  whatsapp    String?
  address     String?
  instagram   String?
  youtube     String?
  themeColor  String   @default("blue") // Ex: 'blue', 'red', 'dark', 'gold'
  heroVideoUrl String?
}

model BioLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  icon        String?  // Nome do ícone do Lucide-react (ex: 'Instagram', 'Youtube')
  isActive    Boolean  @default(true)
  isHighlight Boolean  @default(false) // Se true, o botão pulsa/brilha
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model SermonSeries {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String   // Capa da série (Vertical ou Quadrada)
  startDate   DateTime?
  isActive    Boolean  @default(true)
  sermons     Sermon[]
  createdAt   DateTime @default(now())
}

model Sermon {
  id          String   @id @default(cuid())
  title       String
  youtubeUrl  String
  date        DateTime
  
  seriesId    String
  series      SermonSeries @relation(fields: [seriesId], references: [id])
  
  createdAt   DateTime @default(now())
}

model SiteBanner {
  id          String   @id @default(cuid())
  titulo      String
  subtitulo   String?
  desktopUrl  String
  mobileUrl   String?
  linkBotao   String?
  textoBotao  String?
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  price       Decimal  @default(0) // 0 = Gratuito
  bannerUrl   String?  // Foto do evento
  coverUrl    String?  // Capa do evento (Upload)
  maxCapacity Int?     // Limite de vagas
  registrationDeadline DateTime? // Data limite para inscrições
  isOpen      Boolean  @default(true)
  
  formConfig  Json?    // Armazena a estrutura do form (ex: lista de campos, tipos, labels)
  requiresCpf Boolean  @default(false) // Se true, exige CPF único

  createdAt   DateTime @default(now())
  registrations Registration[]
}

model Registration {
  id String @id @default(cuid())
  eventId String
  userId String?
  guestName String?
  cpf String? // Armazena o CPF limpo (apenas números)
  answers Json? // Armazena as respostas do formulário dinâmico

  status String @default("CONFIRMED") // 'CONFIRMED', 'CANCELED', 'WAITLIST'
  paymentStatus String @default("PENDING") // 'PENDING', 'PAID', 'PARTIAL'
  paidAmount Decimal @default(0)
  checkIn Boolean @default(false) // Se compareceu no dia
  checkInAt DateTime? // Data/hora do check-in
  createdAt DateTime @default(now())
  
  transactions PaymentTransaction[]

  event Event @relation(fields: [eventId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@unique([eventId, userId]) // Não pode se inscrever 2x
  @@unique([eventId, cpf]) // Não pode duplicar CPF no mesmo evento
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // Quem recebe
  title     String
  message   String
  type      String   @default("INFO") // 'INFO', 'SUCCESS', 'WARNING', 'ALERT', 'REPORT', 'ROLE', 'CELL', 'EVENT', 'ROSTER', 'BIRTHDAY'
  read      Boolean  @default(false)
  link      String?  // Url para redirecionar ao clicar (opcional)
  metaData  Json?    // Dados extras para linkar (ex: ID do evento ou da Célula)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GrowthTrackStep {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String? // Nome do ícone Lucide
  orderIndex  Int
  isMandatory Boolean  @default(false)
  
  progressItems MemberGrowthProgress[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MemberGrowthProgress {
  id        String   @id @default(cuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stepId    String
  step      GrowthTrackStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  
  status    String   @default("PENDING") // 'PENDING' | 'COMPLETED'
  completedAt DateTime?
  
  @@unique([userId, stepId])
}

model Cell {
  id          String   @id @default(cuid())
  nome        String
  dia_reuniao String?  // Ex: "Quarta-feira"
  diaSemana   String?  // Ex: "QUARTA", "QUINTA" (Normalizado para filtro)
  horario     String?  // Ex: "20:00"
  endereco    String?
  ativo       Boolean  @default(true)
  
  // Campos para Busca Pública (Geolocalização)
  enderecoBase String? // Endereço completo usado apenas para gerar as coordenadas
  bairro       String? // O dado que será público
  cidade       String?
  latitude     Float?
  longitude    Float?
  
  // Endereço Detalhado (Legado/Administrativo)
  addressStreet    String?
  addressNumber    String?
  addressComplement String?
  addressDistrict  String?
  addressCity      String?
  addressState     String?
  addressZip       String?
  
  // Liderança
  liderId     String?  @unique
  lider       User?    @relation("LiderCelula", fields: [liderId], references: [id])
  
  lider2Id    String?  @unique
  lider2      User?    @relation("Lider2Celula", fields: [lider2Id], references: [id])

  supervisorId String?
  supervisor  User?    @relation("SupervisorCelula", fields: [supervisorId], references: [id])
  
  supervisor2Id String?
  supervisor2 User?    @relation("Supervisor2Celula", fields: [supervisor2Id], references: [id])

  // Cargos
  tesoureiroId String?
  tesoureiro   User?   @relation("TesoureiroCelula", fields: [tesoureiroId], references: [id])

  intercessorId String?
  intercessor   User?   @relation("IntercessorCelula", fields: [intercessorId], references: [id])

  secretarioId  String?
  secretario    User?   @relation("SecretarioCelula", fields: [secretarioId], references: [id])

  eventosId     String?
  eventos       User?   @relation("EventosCelula", fields: [eventosId], references: [id])

  louvorId      String?
  louvor        User?   @relation("LouvorCelula", fields: [louvorId], references: [id])

  anfitriaoId   String?
  anfitriao     User?   @relation("AnfitriaoCelula", fields: [anfitriaoId], references: [id])
  
  mcpId         String?
  mcp           User?   @relation("McpCelula", fields: [mcpId], references: [id])

  // Membros
  membros     User[]   @relation("MembrosCelula")
  
  // Relatórios
  reports     MeetingReport[]
  monthlyClosures MonthlyClosure[]
  rosters     MeetingRoster[]

  // Convites vinculados a esta célula
  invites     Invite[]
  
  // Fotos do Mural
  photos      CellPhoto[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CellPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String?  // Legenda opcional
  cellId    String
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model MeetingReport {
  id              String       @id @default(cuid())
  date            DateTime
  startTime       String?      // "HH:mm"
  endTime         String?      // "HH:mm"
  
  // Cronometragem Exata
  realStartTime   DateTime?    // Hora exata que clicou em 'Iniciar'
  realEndTime     DateTime?    // Hora exata que clicou em 'Finalizar'
  
  studyTheme      String?
  observations    String?      // Observações gerais
  offerDetails    String?      // Detalhamento de Oferta
  cancelReason    String?      // Se status == NAO_HOUVE
  
  // Live Meeting (Secretário)
  startedAt       DateTime?    // Hora que o secretário deu play
  endedAt         DateTime?    // Hora que finalizou
  
  // Escala Realizada
  hostId           String?
  host             User?    @relation("ReportHost", fields: [hostId], references: [id])
  directionId      String?
  direction        User?    @relation("ReportDirection", fields: [directionId], references: [id])
  worshipId        String?
  worship          User?    @relation("ReportWorship", fields: [worshipId], references: [id])
  evangelismId     String?
  evangelism       User?    @relation("ReportEvangelism", fields: [evangelismId], references: [id])

  status          ReportStatus @default(RASCUNHO)
  
  // Fluxo de Correção (Líder -> Secretário)
  returnReason    String?      @db.Text
  returnImageUrl  String?

  // Financeiro Consolidado (Cache)
  offerValue      Float        @default(0) // Total Oferta
  missionsValue   Float        @default(0) // Total Missões
  
  attendance      MeetingAttendance[]
  presentMembers  Int          @default(0) // Cache para total de membros presentes
  visitors        MeetingVisitor[]
  visitorsCount   Int          @default(0) // Cache para total de visitantes
  kidsPillars     MeetingKidsPillars[]
  
  // Cartas de Correção
  corrections     ReportCorrection[]

  cellId          String
  cell            Cell         @relation(fields: [cellId], references: [id])
  
  createdAt       DateTime     @default(now())
}

model ReportCorrection {
  id        String   @id @default(cuid())
  
  reportId  String
  report    MeetingReport @relation(fields: [reportId], references: [id])
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String   @db.Text
  
  createdAt DateTime @default(now())
}

model MeetingAttendance {
  id              String   @id @default(cuid())
  
  status          String   @default("P") // "P", "F", "FJ"
  absenceReason   String?  // Motivo da falta se F/FJ

  offerValue      Float    @default(0)
  titheValue      Float    @default(0)
  missionsValue   Float    @default(0)
  otherValue      Float    @default(0)

  reportId        String
  report          MeetingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([reportId, userId]) // Um usuário só pode ter um registro por relatório
}

model MeetingVisitor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  type      String   // "Visitante", "Primeira Vez", etc.

  reportId  String
  report    MeetingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model MeetingKidsPillars {
  id              String   @id @default(cuid())
  
  church          Boolean  @default(false) // ⛪ Igreja
  cell            Boolean  @default(false) // 🏠 Célula
  homeWorship     Boolean  @default(false) // 🙏 Culto Doméstico
  devotional      Boolean  @default(false) // 📖 Devocional
  challenge       Boolean  @default(false) // 🎯 Desafio

  // Financeiro Kids
  offerValue      Float    @default(0)
  titheValue      Float    @default(0)
  missionsValue   Float    @default(0)
  otherValue      Float    @default(0)

  reportId        String
  report          MeetingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
}



model BrandAsset {
  id        String   @id @default(cuid())
  title     String   // Ex: 'Logo Principal', 'Fonte Oficial'
  type      String   // 'LOGO', 'FONT', 'PALETTE', 'OTHER'
  fileUrl   String?  // Link do arquivo no Storage
  colorHex  String?  // Para paleta de cores (Ex: #FF0000)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String   // Link da imagem
  caption   String?  // Legenda opcional
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model NotificationBlast {
  id        String   @id @default(cuid())
  title     String
  message   String
  target    String   // 'ALL', 'LEADERS', 'MEMBERS', etc
  sentCount Int
  sentAt    DateTime @default(now())
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique @default(uuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  
  // Quem criou o convite (Geralmente o Líder)
  createdById String
  createdBy   User     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Para qual célula o convite é
  cellId      String
  cell        Cell     @relation(fields: [cellId], references: [id])
  
  createdAt   DateTime @default(now())
}

model PrayerLog {
  id        String   @id @default(cuid())
  date      DateTime // Apenas a data (hora zerada ou ignorada na lógica)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

enum MonthlyClosureStatus {
  ABERTO
  AGUARDANDO_LIDER
  AGUARDANDO_SUPERVISOR
  AGUARDANDO_COORDENACAO
  CONCLUIDO
}

model MonthlyClosure {
  id              String   @id @default(cuid())
  
  cellId          String
  cell            Cell     @relation(fields: [cellId], references: [id])
  
  month           Int      // 1-12
  year            Int      // 2024, etc
  
  status          MonthlyClosureStatus @default(ABERTO)
  
  // Totais do mês
  totalMeetings   Int      @default(0)
  totalOffer      Float    @default(0)
  totalMissions   Float    @default(0)
  avgAttendance   Float    @default(0)
  
  // Assinaturas (Datas)
  liderSignedAt      DateTime?
  supervisorSignedAt DateTime?
  coordSignedAt      DateTime?
  
  // Quem assinou
  liderId            String?
  lider              User?    @relation("LiderAssinatura", fields: [liderId], references: [id])
  
  supervisorId       String?
  supervisor         User?    @relation("SupervisorAssinatura", fields: [supervisorId], references: [id])
  
  coordId            String?
  coord              User?    @relation("CoordAssinatura", fields: [coordId], references: [id])

  // Motivo de Correção (se status voltar)
  correctionReason   String?

  // Controle de Prazo
  submittedAt        DateTime? // Data do envio final do mês
  isLate             Boolean   @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cellId, month, year])
}

model MeetingRoster {
  id          String   @id @default(cuid())
  date        DateTime // Data da reunião
  
  cellId      String
  cell        Cell     @relation(fields: [cellId], references: [id])
  
  // Funções
  directionId String?
  direction   User?    @relation("RosterDirection", fields: [directionId], references: [id])
  
  worshipId   String?
  worship     User?    @relation("RosterWorship", fields: [worshipId], references: [id])
  
  evangelismId String?
  evangelism  User?    @relation("RosterEvangelism", fields: [evangelismId], references: [id])
  
  hostId      String?
  host        User?    @relation("RosterHost", fields: [hostId], references: [id])
  
  // Local da Reunião
  customAddress String?
  latitude      Float?
  longitude     Float?
  
  // Financeiro (Previsão)
  offerPrediction Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([cellId, date])
  @@map("meeting_rosters")
}

model SiteConfiguration {
  id              Int      @id @default(1)
  
  heroTitle       String?
  heroSubtitle    String?
  heroBgImage     String?
  heroCtaText     String?
  heroCtaLink     String?
  
  // Barra de Avisos
  alertActive     Boolean  @default(false)
  alertTitle      String?
  alertText       String?
  alertColor      String   @default("bg-indigo-600")
  alertLink       String?
  
  weeklySchedule  String? // JSON
  
  contactWhatsapp String?
  socialInstagram String?
  footerAddress   String?

  isLive          Boolean  @default(false)
}

// System Feedback
model SystemFeedback {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
	type String @default("GERAL")
  message String @default("Sem mensagem")
  rating      Int?     // 1-5
  status      String   @default("PENDING") // 'PENDING', 'REVIEWED', 'RESOLVED'
  createdAt   DateTime @default(now())
}

// Payment Transaction (Stripe/Payment Gateway)
model PaymentTransaction {
  id            String   @id @default(cuid())
  registrationId String
  registration  Registration @relation(fields: [registrationId], references: [id])
  amount        Decimal
  currency      String   @default("BRL")
 status String @default("PENDING")
  providerId    String?  // ID do pagamento no Stripe/Gateway
  createdAt     DateTime @default(now())
}

// Calendar Event (Agenda Anual)
model CalendarEvent {
  id        String   @id @default(cuid())
  title     String   // Ex: "Santa Ceia", "Dia da Bíblia"
  date      DateTime // Data do evento
  createdAt DateTime @default(now())
}

model PastoralMessage {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  videoUrl  String?
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrayerRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  content   String
  status    String   @default("PENDING")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Resource {
  id          String   @id @default(cuid())
  titulo      String
  tipo        ResourceType
  fileUrl     String
  publicoAlvo ResourceAudience
  createdAt   DateTime @default(now())
}

model Oikos {
  id        String   @id @default(cuid())
  nome      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

